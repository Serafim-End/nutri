## Local development environment
## Only required manual input: TELEGRAM_BOT_TOKEN

# Enable bot profile by default
COMPOSE_PROFILES=bot

# Telegram Bot
TELEGRAM_BOT_TOKEN=8498205691:AAHVh4IxJpG0UNEVVgHTmoJgIFbpVfxOXjc
BOT_SERVICE_TOKEN=dev-bot-service-token
TELEGRAM_MODE=webhook
# Set by scripts/ngrok_set_env.sh while ngrok is running
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
WEBAPP_URL=https://t.me/your_bot/app

# Backend API for bot
BACKEND_URL=http://backend:5000

# Database (local container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nutrimatch
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nutrimatch

# Frontend build-time API base (admin panel)
VITE_API_BASE_URL=http://localhost:5000/api
