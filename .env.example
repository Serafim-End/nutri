# NutriMatch Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE (Required)
# ============================================

# Supabase PostgreSQL connection string
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# SSL is automatically enabled for Supabase connections
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ============================================
# FLASK
# ============================================

# Flask environment (development/production)
FLASK_ENV=development

# Enable debug mode (1=yes, 0=no)
FLASK_DEBUG=1

# Secret key for session signing (change in production!)
SECRET_KEY=dev-secret-key-change-in-production

# ============================================
# AUTHENTICATION
# ============================================

# JWT secret key (defaults to SECRET_KEY if not set)
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# JWT token expiration in hours
JWT_EXPIRY_HOURS=24

# Telegram bot token for auth verification
TELEGRAM_BOT_TOKEN=

# ============================================
# CORS
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ============================================
# BOOKING
# ============================================

# How long a slot is held before payment (minutes)
SLOT_HOLD_MINUTES=10

# ============================================
# PAYMENTS
# ============================================

# Webhook signature verification secret
PAYMENT_WEBHOOK_SECRET=webhook-secret

# ============================================
# LOCAL DOCKER (optional, for docker-compose)
# ============================================

# Only used when running local Postgres via docker-compose
# (ignored when using Supabase DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nutrimatch
