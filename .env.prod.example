# =============================================================================
# NutriMatch Production Environment Variables
# =============================================================================
#
# Copy this file to .env.prod and fill in all required values.
#
# Usage:
#   cp .env.prod.example .env.prod
#   # Edit .env.prod with your values
#   make up
#
# =============================================================================

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# Your production domain (without protocol)
DOMAIN=example.com

# API URL for frontend builds (must use HTTPS with Cloudflare)
VITE_API_BASE_URL=https://api.example.com

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Get connection string from Supabase Dashboard > Settings > Database
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# JWT token expiration in hours
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# Supabase (optional, for additional features)
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Google OAuth (optional, for calendar integration)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URL=https://api.example.com/api/calendar/google/callback

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
# Get from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Bot operation mode: polling (development) or webhook (production)
TELEGRAM_MODE=polling

# Webhook URL (required if TELEGRAM_MODE=webhook)
# This should be the public URL where Telegram can reach your bot
WEBHOOK_URL=https://bot.example.com

# Service token for bot-to-backend authentication
# Generate with: openssl rand -hex 32
BOT_SERVICE_TOKEN=your-bot-service-token

# Mini App URL (the Telegram Mini App web interface)
WEBAPP_URL=https://app.example.com

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# Available providers: mock, telegram, yookassa, cloudpayments
PAYMENT_PROVIDER=mock

# Webhook signature verification key
# Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Provider-specific settings (uncomment as needed):
# YOOKASSA_SHOP_ID=your-shop-id
# YOOKASSA_SECRET_KEY=your-secret-key
# CLOUDPAYMENTS_PUBLIC_ID=your-public-id
# CLOUDPAYMENTS_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins (your frontend domains)
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# -----------------------------------------------------------------------------
# Booking Configuration
# -----------------------------------------------------------------------------
# How long to hold a slot while client completes payment (minutes)
SLOT_HOLD_MINUTES=10
BOOKING_HOLD_MINUTES=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
