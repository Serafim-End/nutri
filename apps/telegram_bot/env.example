# NutriMatch Telegram Bot Configuration
# Copy this file to .env and fill in the values

# ==========================================
# REQUIRED
# ==========================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Service token for backend API authentication
# Must match BOT_SERVICE_TOKEN in backend .env
BOT_SERVICE_TOKEN=your_service_token_here

# Database URL (same as backend, for FSM state storage)
DATABASE_URL=postgresql://user:password@localhost:5432/nutrimatch

# ==========================================
# BACKEND CONNECTION
# ==========================================

# Backend API URL (internal, for bot-to-backend communication)
BACKEND_URL=http://localhost:5000

# Public backend URL (for links shown to users, e.g. document links)
# If not set, defaults to BACKEND_URL
# PUBLIC_BACKEND_URL=https://api.nutrutioncoach.com

# ==========================================
# BOT MODE
# ==========================================

# Mode: "polling" for development, "webhook" for production
TELEGRAM_MODE=polling

# Webhook settings (only needed if TELEGRAM_MODE=webhook)
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443

# ==========================================
# MINI APP
# ==========================================

# URL to the Mini App (shown in WebApp button)
WEBAPP_URL=https://t.me/your_bot/app

# ==========================================
# OPTIONAL
# ==========================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==========================================
# DEBUG & TESTING
# ==========================================

# Enable debug mode (enables /debug command)
# Set to "true" only in development!
BOT_DEBUG=false

# Test user Telegram IDs (for seed_test_users.py)
TEST_CLIENT_TELEGRAM_ID=111111111
TEST_NUTRITIONIST_TELEGRAM_ID=222222222

