# =============================================================================
# Production Environment Variables Template
# =============================================================================
# Copy this file to .env.prod and fill in all values
# DO NOT commit .env.prod to git (it contains secrets)
# =============================================================================

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# API base URL for frontend applications (client & admin_panel)
# Must use https://api.nutrutioncoach.com/api for production (includes /api prefix)
VITE_API_BASE_URL=https://api.nutrutioncoach.com/api

# =============================================================================
# DATABASE (PostgreSQL - Local Container)
# =============================================================================
# PostgreSQL connection settings for the containerized database
# IMPORTANT: Use the SAME password in both POSTGRES_PASSWORD and DATABASE_URL
POSTGRES_USER=nutri
POSTGRES_PASSWORD=your-secure-password-change-me
POSTGRES_DB=nutri

# Database URL for application connection
# Uses 'postgres' as hostname (docker-compose service name)
# IMPORTANT: Password here MUST match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://nutri:your-secure-password-change-me@postgres:5432/nutri

# =============================================================================
# SECURITY KEYS
# =============================================================================
# Generate with: openssl rand -hex 32
# Or use online: https://randomkeygen.com/ (CodeIgniter Encryption Keys)
# Or use simple strings for MVP (minimum 32 characters): my-super-secret-key-for-production-2024-change-later
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# =============================================================================
# TELEGRAM BOT
# =============================================================================
# Get from: @BotFather on Telegram → /mybots → Your Bot → API Token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# Service token for bot-to-backend authentication
# Generate with: openssl rand -hex 32
# Or use simple string (minimum 32 characters)
# IMPORTANT: Must match BOT_SERVICE_TOKEN in backend
BOT_SERVICE_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# Bot mode: "webhook" for production, "polling" for development
TELEGRAM_MODE=webhook

# Webhook URL for Telegram (full HTTPS URL)
WEBHOOK_URL=https://bot.nutrutioncoach.com/webhook

# Mini App URL (shown in bot's WebApp button)
WEBAPP_URL=https://tma.nutrutioncoach.com

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for API requests (comma-separated, no spaces)
CORS_ORIGINS=https://web.nutrutioncoach.com,https://tma.nutrutioncoach.com,https://web.telegram.org,https://t.me

# =============================================================================
# BOOKING CONFIGURATION
# =============================================================================
# Time in minutes to hold a slot before releasing it
SLOT_HOLD_MINUTES=10
BOOKING_HOLD_MINUTES=10

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================
# Payment provider: "mock", "telegram", "yookassa", "cloudpayments"
PAYMENT_PROVIDER=prodamus

# Webhook secret for payment providers
# Generate with: openssl rand -hex 32
# Or use simple string (minimum 32 characters)
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Prodamus Payform settings
PAYFORM_FORM_URL=https://vitakotsarenko.payform.ru/
PAYFORM_SYS=vitanutri
PAYFORM_SECRET=CHANGE_ME_payform_secret
PAYFORM_SUCCESS_URL=https://tma.nutrutioncoach.com/payment/success
PAYFORM_RETURN_URL=https://tma.nutrutioncoach.com/payment/fail
PAYFORM_NOTIFICATION_URL=https://api.nutrutioncoach.com/api/payments/webhook/prodamus
PAYFORM_LINK_EXPIRE_MINUTES=15

# =============================================================================
# OPTIONAL / LOGGING
# =============================================================================
# Log level for telegram bot: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
